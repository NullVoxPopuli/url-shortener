{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "rebuild": "./rebuild.sh",
    "start": "node bin/server.js",
    "build": "pnpm build:swagger && pnpm build:server",
    "build:swagger": "node ace swagger:generate",
    "build:server": "node ace build --ignore-ts-errors",
    "ace": "NODE_OPTIONS='--no-deprecation' node ace ",
    "dev": "LOG_LEVEL=trace NODE_OPTIONS='--no-deprecation' node ace serve --hmr",
    "dev:offline": "LOG_LEVEL=trace NODE_ENV=development DB_CONNECTION=sqlite3 NODE_OPTIONS='--no-deprecation' node ace serve --hmr",
    "db:offline:reset": "pnpm db:reset && pnpm db:seed",
    "db:reset": "DB_CONNECTION=sqlite3 node ace migration:fresh",
    "db:seed": "DB_CONNECTION=sqlite3 node ace db:seed",
    "test": "NODE_OPTIONS='--no-deprecation' node ace test",
    "test:watch": "NODE_OPTIONS='--no-deprecation' node ace test --watch",
    "test:debug": "./test-debug.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#consts": "./app/consts.js",
    "#jsonapi": "./app/jsonapi/index.js",
    "#jsonapi/*": "./app/jsonapi/*.js",
    "#openapi": "./app/openapi.js",
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#utils/*": "./utils/*.js",
    "#config/*": "./config/*.js",
    "#generated/*": "./.adonisjs/server/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/eslint-config": "3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@faker-js/faker": "^10.2.0",
    "@japa/api-client": "^3.0.3",
    "@japa/assert": "^4.0.1",
    "@japa/browser-client": "^2.1.1",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@swc/core": "^1.10.14",
    "@types/chai": "^5.0.1",
    "@types/common-tags": "^1.8.4",
    "@types/luxon": "^3.4.2",
    "@types/node": "^25.0.9",
    "@types/uuid": "^11.0.0",
    "better-sqlite3": "^12.6.2",
    "chai": "^6.2.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.19.0",
    "hot-hook": "^0.4.0",
    "openapi3-ts": "^4.4.0",
    "playwright": "^1.50.1",
    "prettier": "github:jurgenwerk/prettier#glimmer-embed-style-wip",
    "prettier-plugin-edgejs": "^1.0.7",
    "typescript": "^5.7.3",
    "uuid": "^13.0.0",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/ally": "^6.3.0",
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/bouncer": "^4.0.0",
    "@adonisjs/core": "^7.3.5",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/limiter": "^3.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/static": "^2.0.1",
    "@nullvoxpopuli/url-compression": "workspace:^",
    "@vinejs/vine": "^4.4.0",
    "common-tags": "^1.8.2",
    "edge.js": "^6.5.1",
    "find-up": "^8.0.0",
    "luxon": "^3.5.0",
    "node-confirm": "^1.0.2",
    "pg": "^8.13.1",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "stripe": "^17.7.0",
    "ts-deepmerge": "^7.0.2",
    "ts-japi": "^1.11.5"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "packageManager": "pnpm@10.28.0",
  "volta": {
    "extends": "../package.json"
  }
}
