{
  "name": "web-client",
  "version": "0.0.0",
  "private": true,
  "description": "Small description for web-client goes here",
  "repository": "",
  "license": "MIT",
  "author": "",
  "scripts": {
    "build": "vite build",
    "_lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "_lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\"",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "tsc --noEmit --runExternalCode",
    "start": "vite --port 5002",
    "build:test": "EMBER_ENV=test NODE_ENV=development vite build --mode development",
    "test": "pnpm build:test && pnpm test:ci",
    "test:ci": "testem ci --port 0",
    "ember:update": "npx ember-cli-update",
    "ember:update:the-hard-way": "npx ember-cli@latest init --blueprint @embroider/app-blueprint --pnpm --typescript --name web-client"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@ember/app-tsconfig": "^2.0.0",
    "@ember/test-helpers": "^5.4.3",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/core": "^4.6.7",
    "@glint/ember-tsc": "^1.11.4",
    "@glint/template": "1.9.0",
    "@nullvoxpopuli/ember-vite": "^1.1.1",
    "@nullvoxpopuli/eslint-configs": "^7.0.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@types/qunit": "^2.19.14",
    "@types/rsvp": "^4.0.9",
    "@typescript/native": "npm:typescript@7.1.0-dev.20260919.1",
    "@warp-drive/build-config": "5.9.1",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^10.0.5",
    "decorator-transforms": "^2.4.0",
    "ember-cli-deprecation-workflow": "^4.0.1",
    "ember-content-mapper": "^0.3.1",
    "ember-qunit": "^9.1.0",
    "ember-scoped-css": "^3.5.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "qunit": "^2.26.0",
    "qunit-dom": "^3.6.0",
    "testem": "^3.21.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0"
  },
  "ember": {
    "edition": "octane"
  },
  "imports": {
    "#app/*": "./app/*",
    "#config": "./app/config.ts",
    "#components/*": "./app/components/*",
    "#services/*": "./app/services/*",
    "#test-helpers/*": "./tests/helpers/*",
    "#utils/*": "./app/utils/*"
  },
  "ember-addon": {
    "type": "app",
    "version": 2
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "dependencies": {
    "@embroider/macros": "^1.21.1",
    "@embroider/router": "^3.0.6",
    "@glimmer/component": "^2.1.1",
    "@warp-drive/core": "^5.9.1",
    "@warp-drive/ember": "5.9.1",
    "@warp-drive/json-api": "^5.9.1",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.0.3",
    "ember-primitives": "^0.62.0",
    "ember-resources": "^7.1.0",
    "ember-source": "~7.3.0",
    "nvp.ui": "^0.10.0",
    "qrcode-generator": "^2.0.4",
    "reactiveweb": "^1.9.3"
  }
}
